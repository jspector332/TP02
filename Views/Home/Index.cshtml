@{
    ViewData["Title"] = "Home Page";
}

<form action = '@Url.Action("generarSugerencia", "Home")' method ="get">
    <h2>Nombre completo:</h2> <input type="text" name="nombreCocinero" placeholder="Aqui tu nombre"></br>
    <h2>Fecha de Nacimiento:</h2> <input type="date" name="fNacimiento"></br>
    <h2>Tipo de Comida:</h2> <input type="radio" name="tipoComida" value="caliente"> Caliente
                    <input type="radio" name="tipoComida" value="fria"> Fria</br>
    <h2>Presupuesto:</h2> <input type="number" name="presupuesto" min="1" placeholder="Mayor a 0"></br>
    <h2>Cantidad de Personas:</h2> <input type="number" name="cantidad" min="1" max="20" placeholder="1-20"></br>
    <input type="submit" value="Entregar">
    <input type="reset"value="Reiniciar">
</form>
