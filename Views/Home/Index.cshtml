@{
    ViewData["Title"] = "Home Page";
}

<form action = '@Url.Action("generarSugerencia", "Home")' method ="get">
    Nombre completo: <input type="text" name="nombreCocinero"></br>
    Fecha de Nacimiento: <input type="date" name="fNacimiento"></br>
    Tipo de Comida: <input type="radio" name="tipoComida" value="caliente"> Caliente
                    <input type="radio" name="tipoComida" value="fria"> Fria</br>
    Presupuesto: <input type="number" name="presupuesto" min="1" placeholder="Mayor a 0"></br>
    Cantidad de Personas: <input type="number" name="cantidad" min="1" max="20" placeholder="1-20"></br>
    <input type="submit" value="Entregar">
    <input type="reset"value="Reiniciar">
</form>
